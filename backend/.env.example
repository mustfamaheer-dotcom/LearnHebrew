# ==============================================================================
# LearnHebrew Backend Production Environment Configuration
# ==============================================================================

# Server Environment (production / development / test)
NODE_ENV=production
PORT=5001
APP_NAME=LearnHebrew

# Database (PostgreSQL with Connection Pooling)
DATABASE_URL="postgresql://db_user:db_password@postgres_host:5432/learnhebrew?schema=public&connection_limit=20&pool_timeout=10"

# Public-facing Frontend URL for CORS Security & Email redirect links (NO trailing slash)
FRONTEND_URL="https://learnhebrew.academy"

# JSON Web Token Cryptographic Secrets (minimum 64 random characters)
# Generate with: openssl rand -base64 48
JWT_SECRET="generate_a_cryptographically_secure_random_64_character_secret_here"
JWT_EXPIRES_IN="15m"

JWT_REFRESH_SECRET="generate_a_different_secure_random_64_character_secret_here"
JWT_REFRESH_EXPIRES_IN="7d"

# Password Hashing Cost (12 is OWASP standard for bcrypt)
BCRYPT_ROUNDS=12

# In-Memory / Distributed Cache (Optional: Redis URL)
# If omitted or unavailable, an in-memory TTL cache fallback is automatically activated
REDIS_URL="redis://default:redis_password@redis_host:6379"

# SECURITY WARNING: NEVER enable this in production environments!
# ENABLE_DEV_LOGIN_BYPASS=false
